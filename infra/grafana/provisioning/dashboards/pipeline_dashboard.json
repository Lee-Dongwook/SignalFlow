{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Throughput (Records/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsInPerSecond[1m]))",
          "legendFormat": "Input Rate"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsOutPerSecond[1m]))",
          "legendFormat": "Processed Output Rate"
        }
      ]
    },
    {
      "title": "Data Quality & Drop Ratio (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(1 - (sum(rate(flink_taskmanager_job_task_operator_numRecordsOutPerSecond[1m])) / sum(rate(flink_taskmanager_job_task_operator_numRecordsInPerSecond[1m])))) * 100",
          "legendFormat": "Filtered/Dropped Ratio (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "title": "Pipeline End-to-End Latency / Lag (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "avg(flink_taskmanager_job_task_operator_currentFetchDelayMs)",
          "legendFormat": "Fetch Lag Delay (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["pipeline", "quality", "observability"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "AI Data Pipeline - Realtime Quality & Health Metrics",
